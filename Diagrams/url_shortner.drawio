        <mxCell id="p-asIFV21MIEWjqzHZch-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;div style=&quot;&quot;&gt;URL Shortner like Bit.ly&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Bit.ly is a URL shortner service that lets you shorten and customize link&lt;/div&gt;&lt;div style=&quot;&quot;&gt;eg: https://sourcemaking.com/design_patterns/builder =&amp;gt; http://bit.ly/4kyL0uy&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="138" width="444" x="483" y="265" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-2" parent="1" style="whiteSpace=wrap;html=1;align=left;fillColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;FR&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;3&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;- Create a short URL&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;3&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Optional Custom URL&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;3&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Optional support expiration Time&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font size=&quot;3&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;- User should get redirected to the actual URL from short URL&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="141" width="351" x="483" y="438" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;NFRs&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;- Low Latency (url-redirection and creation)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;- Scale - 500M new URL/ Month&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;-shorten URL should be Unique&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;- CAP : Availbility &amp;gt;&amp;gt; Consistency&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="149" width="350" x="1063" y="438" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); font-size: 24px;&quot;&gt;1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="411" y="416" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;2.Capacity Estimation and Constraints&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="31" width="615" x="359" y="620" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-6" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: medium; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Read Heavy&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Assume 100 : 1 (Read : Write)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Assume 500M new URL per month&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;with 100 : 1&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;50B -&amp;gt; Redirection in same period&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;QPS = 500M /(30days * 24Hours*3600 seconds) ~ 200 URL/Sec&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Considering 100:1 =&amp;gt; 100*200URL/Sec = 20K URL/Sec Redirection&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="153" width="504" x="379" y="658" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-7" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;u&gt;Storage Estimation&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Store URL for 5 Years&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;500M new URLs / Month then&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;500M * 5 years * 12 = 30B&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Each stored Object 500 bytes&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;30B * 500byte = 15000GB=15 TB&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="265" x="947" y="658" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-8" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bandwidth Estimate&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;200URL/sec&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;Total incoming data = 200*500bytes = 100 KB/sec&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;For read request&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;100:1 =&amp;gt; 100KB/sec *100 = 10MB/sec&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="373" x="1247" y="658" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: rgb(255, 181, 112); font-size: 14px;&quot;&gt;Not Covered&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 181, 112); font-size: 14px;&quot;&gt;1) Analytics e.g. How many times redirection happened&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 181, 112); font-size: 14px;&quot;&gt;2) Our Service should also be accessible through REST APIs&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 181, 112); font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; by other services&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 181, 112); font-size: 14px;&quot;&gt;- Assum short URL consist of combination of Numbers and characters&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="62" width="481" x="1157" y="252" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-10" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;u&gt;Memory Estimate&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Follow 80-20 rule means 20% of URL generate 80% of traffic&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;20k URL/sec =&amp;gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;20k * 3600 Seconds * 24 Hours = 1.7 B&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;To Cache it&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; 0.2 * 1.7B * 500B = 170 GB(It can be less because lot of duplicate URL)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="534" x="379" y="827" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-11" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;High Level Estimate (500M new URL/month)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;100:1 (read to write )&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;New URLs = 200URL/sec&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;URL redirection = 20K URL/sec&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;Incoming Data =&amp;nbsp; 100KB/sec&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;Outgoing Data = 10MB/sec&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;Storage for 5 Years = 15 TB&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(234, 107, 102);&quot;&gt;Memory for cache = 170GB&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="131" width="283" x="1259" y="832" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;3. DataBase Design&lt;/font&gt;" vertex="1">
          <mxGeometry height="33" width="368" x="357" y="1024" as="geometry" />
        </mxCell>
        <mxCell id="p-asIFV21MIEWjqzHZch-13" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1) &lt;/font&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;need to store the billion of Records&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;2) Each Object we store is small(&amp;lt;1KB)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;3) No relationships between records&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; (Other that which user created a URL)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;4) Service is read-heavy&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Database Schema&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Two tables : One for storing information&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; about the URL mappings&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; and one for user&#39;s data who created&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; the short link&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="486" x="384" y="1057" as="geometry" />
        </mxCell>
